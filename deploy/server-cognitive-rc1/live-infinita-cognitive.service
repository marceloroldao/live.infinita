[Unit]
Description=Live Infinita Server Cognitive RC1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/live.infinita
ExecStart=%h/live.infinita/deploy/server-cognitive-rc1/run.sh
Environment=LIVE_COGNITIVE_HOST=127.0.0.1
Environment=LIVE_COGNITIVE_PORT=8090
Environment=LIVE_COGNITIVE_AUTORUN=1
Environment=LIVE_COGNITIVE_STEP_SECONDS=1.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
