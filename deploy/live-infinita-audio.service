[Unit]
Description=Live Infinita Server Audio
After=network-online.target live-infinita.service
Wants=network-online.target
Requires=live-infinita.service

[Service]
Type=simple
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
EnvironmentFile=-/etc/live-infinita/audio.env
Environment="LIVE_INFINITA_WORLD_WALK_SPEED=48.0"
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/audio-service/retro_audio.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/live-infinita

[Install]
WantedBy=multi-user.target
