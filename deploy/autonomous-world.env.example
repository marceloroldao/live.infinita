# Required persistent world paths
LIVE_INFINITA_DATA_DIR=/var/lib/live-infinita
LIVE_INFINITA_COLD_STORE_DIR=/var/lib/live-infinita/cold-store
LIVE_INFINITA_COLD_BOOTSTRAP_FILE=/opt/live.infinita/examples/world-state.nov-autonomous.bootstrap.json

# Comma-separated authoritative NPC entity ids.
# Enable only ids that already exist in the cold store/bootstrap.
LIVE_INFINITA_NPC_IDS=nov

# Logical simulation cadence; wall time schedules ticks but downtime is never replayed.
LIVE_INFINITA_TICK_DURATION_MS=500

# Optional lease owner label for observability.
LIVE_INFINITA_TICK_OWNER=autonomous-world
