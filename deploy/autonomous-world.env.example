# Dedicated authoritative autonomous world state.
# Runtime logs/actors remain under /var/lib/live-infinita; only the simulated world
# and its cognitive state live in this isolated subtree.
LIVE_INFINITA_DATA_DIR=/var/lib/live-infinita/autonomous-world
LIVE_INFINITA_COLD_STORE_DIR=/var/lib/live-infinita/autonomous-world/cold-store
LIVE_INFINITA_COLD_BOOTSTRAP_FILE=/opt/live.infinita/examples/world-state.nov-live.bootstrap.json

# Comma-separated authoritative NPC entity ids.
LIVE_INFINITA_NPC_IDS=nov

# Logical simulation cadence; wall time schedules ticks but downtime is never replayed.
LIVE_INFINITA_TICK_DURATION_MS=500

# Optional lease owner label for observability.
LIVE_INFINITA_TICK_OWNER=autonomous-world
