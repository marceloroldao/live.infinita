[Unit]
Description=Live Infinita — Nov spatial StructuralEvent sync into local Memoria.ia
After=live-infinita-memoria-local.service
Requires=live-infinita-memoria-local.service
ConditionPathExists=/var/lib/live-infinita/autonomous-world/deltas.jsonl
ConditionPathExists=/var/lib/live-infinita/autonomous-world/world.json

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime"
EnvironmentFile=/etc/live-infinita/memoria-local.env
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/nov_spatial_memory_sync.py --max-events 1
TimeoutStartSec=100
UMask=0077
Nice=15
CPUWeight=10
IOWeight=10
MemoryHigh=128M
MemoryMax=256M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadWritePaths=/var/lib/live-infinita/memoria-local
IPAddressDeny=any
IPAddressAllow=localhost
