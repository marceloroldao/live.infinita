[Unit]
Description=Live Infinita shadow search regions from Nov recalled eye encounters
After=live-infinita-animal-memory.service live-infinita-renderer.service

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/nov_animal_search_prediction.py
TimeoutStartSec=20
UMask=0077
Nice=15
CPUWeight=10
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadWritePaths=/var/lib/live-infinita/wildlife
ReadWritePaths=/var/www/live-infinita-godot/wildlife
IPAddressDeny=any
