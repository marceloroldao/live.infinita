[Unit]
Description=Live Infinita — social cognitive evidence sync into local Memoria.ia
After=live-infinita.service live-infinita-memoria-local.service
Requires=live-infinita-memoria-local.service
ConditionPathExists=/var/lib/live-infinita/cognitive-evidence.jsonl

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime"
EnvironmentFile=/etc/live-infinita/memoria-local.env
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/cognitive_evidence_sync.py --max-records 32
TimeoutStartSec=30
UMask=0077
Nice=15
CPUWeight=10
IOWeight=10
MemoryHigh=128M
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/cognitive-evidence.jsonl
ReadWritePaths=/var/lib/live-infinita/memoria-local
IPAddressDeny=any
IPAddressAllow=localhost
