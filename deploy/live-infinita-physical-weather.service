[Unit]
Description=Live Infinita bounded persistent physical atmosphere

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime"
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/world_physical_weather.py
TimeoutStartSec=30
UMask=0077
Nice=15
CPUWeight=10
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadWritePaths=/var/lib/live-infinita/weather
ReadWritePaths=/var/lib/live-infinita/cognitive-terrain
IPAddressDeny=any
