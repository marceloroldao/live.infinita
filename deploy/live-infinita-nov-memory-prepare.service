[Unit]
Description=Live Infinita Nov standalone V2 preparer (manual activation only)
After=local-fs.target live-infinita-memoria-local.service
Requires=live-infinita-memoria-local.service
StartLimitIntervalSec=600
StartLimitBurst=3
ConditionPathExists=/var/lib/live-infinita/memoria-local/external-episodes-incremental/external-episodes.sqlite3
ConditionPathExists=/var/lib/live-infinita/memoria-local/nov-ingest.checkpoint.json
ConditionPathExists=/var/lib/live-infinita/autonomous-world/world.json
ConditionPathExists=/var/lib/live-infinita/autonomous-world/cold-store/manifest.json
ConditionPathExists=@PINNED_CORE_ROOT@/memoria_resolutiva/external_episode_incremental.py
ConditionPathExists=@NOV_RELEASE_ROOT@/nov_memory_continuous.py

[Service]
Type=simple
User=liveinfinita
Group=liveinfinita
WorkingDirectory=@NOV_RELEASE_ROOT@
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=@NOV_RELEASE_ROOT@:@PINNED_CORE_ROOT@"
ExecStart=@VENV_PYTHON@ @NOV_RELEASE_ROOT@/nov_memory_continuous.py --period 2 --refresh 4 --scratch-root /run/live-infinita-nov-preparer
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
UMask=0077
RuntimeDirectory=live-infinita-nov-preparer
RuntimeDirectoryMode=0700
Nice=15
CPUWeight=10
IOWeight=10
MemoryHigh=192M
MemoryMax=384M
TasksMax=24
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadOnlyPaths=/var/lib/live-infinita/memoria-local
ReadWritePaths=/run/live-infinita-nov-preparer
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
