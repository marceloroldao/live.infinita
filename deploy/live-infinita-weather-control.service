[Unit]
Description=Live Infinita prospective weather prediction control
After=live-infinita-physical-weather.service

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime"
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/world_weather_control.py
TimeoutStartSec=30
UMask=0077
Nice=15
CPUWeight=10
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadOnlyPaths=/var/lib/live-infinita/cognitive-terrain
ReadWritePaths=/var/lib/live-infinita/weather
ReadWritePaths=/var/www/live-infinita-godot/navigation-memory
IPAddressDeny=any
