[Unit]
Description=Live Infinita — bounded structural association consolidation
After=live-infinita-memoria-local.service
Requires=live-infinita-memoria-local.service

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime"
EnvironmentFile=/etc/live-infinita/memoria-local.env
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/structural_association_consolidator.py --max-observations 2
TimeoutStartSec=90
UMask=0077
Nice=18
CPUWeight=8
IOWeight=8
MemoryHigh=64M
MemoryMax=128M
TasksMax=12
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
IPAddressDeny=any
IPAddressAllow=localhost
