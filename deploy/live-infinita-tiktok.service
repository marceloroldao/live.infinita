[Unit]
Description=Live Infinita MVP-005 TikTok Live Source Bridge
After=network-online.target live-infinita.service
Wants=network-online.target
Requires=live-infinita.service

[Service]
Type=simple
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
EnvironmentFile=/etc/live-infinita/tiktok.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/sources/tiktok_live_bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
