[Unit]
Description=Live Infinita confirmed aggregate memory sky metadata
After=live-infinita-memoria-local.service
Requires=live-infinita-memoria-local.service

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime"
EnvironmentFile=/etc/live-infinita/memoria-local.env
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/world_memory_sky.py
TimeoutStartSec=90
UMask=0077
Nice=15
CPUWeight=10
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadWritePaths=/var/lib/live-infinita/memoria-local
ReadWritePaths=/var/lib/live-infinita/cognitive-terrain
IPAddressDeny=any
IPAddressAllow=localhost
