[Unit]
Description=Live Infinita MVP-003
After=network.target

[Service]
Type=simple
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment="PYTHONUNBUFFERED=1"
Environment="LIVE_INFINITA_DATA_DIR=/var/lib/live-infinita"
ExecStart=/opt/live.infinita/.venv/bin/uvicorn --app-dir /opt/live.infinita/apps/world-runtime main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
