[Unit]
Description=Live Infinita Nov eye encounters to local structural memory
After=live-infinita-renderer.service live-infinita-memoria-local.service
Wants=live-infinita-memoria-local.service

[Service]
Type=oneshot
User=liveinfinita
Group=liveinfinita
WorkingDirectory=/opt/live.infinita
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/live.infinita:/opt/live.infinita/apps/world-runtime
EnvironmentFile=/etc/live-infinita/memoria-local.env
ExecStart=/opt/live.infinita/.venv/bin/python /opt/live.infinita/apps/world-runtime/nov_animal_memory_sync.py
TimeoutStartSec=65
UMask=0077
Nice=15
CPUWeight=10
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/live-infinita/autonomous-world
ReadWritePaths=/var/lib/live-infinita/wildlife
ReadWritePaths=/var/www/live-infinita-godot/wildlife
IPAddressDeny=any
IPAddressAllow=localhost
