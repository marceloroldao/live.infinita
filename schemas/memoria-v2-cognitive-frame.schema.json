{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live.infinita/schema/memoria-v2-cognitive-frame.schema.json",
  "title": "MemoriaV2CognitiveFrame",
  "type": "object",
  "required": ["frame_id", "tick_id", "observer_id", "state_addresses", "available_interventions"],
  "properties": {
    "frame_id": {"type": "string", "minLength": 1},
    "tick_id": {"type": "integer", "minimum": 0},
    "observer_id": {"type": "string", "minLength": 1},
    "state_addresses": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "available_interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intervention_address", "proposal_id"],
        "properties": {
          "intervention_address": {"type": "string", "minLength": 1},
          "proposal_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "candidate_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "consequence_addresses", "next_state_addresses"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "consequence_addresses": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "next_state_addresses": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "properties": {
        "world_version": {"type": ["string", "integer", "null"]},
        "snapshot_id": {"type": ["string", "null"]},
        "event_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
