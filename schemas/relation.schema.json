{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live.infinita/schema/relation.schema.json",
  "title": "Relation",
  "type": "object",
  "required": ["relation_id", "subject", "predicate", "object", "status", "version"],
  "properties": {
    "relation_id": {"type": "string"},
    "subject": {"type": "string"},
    "predicate": {"type": "string"},
    "object": {},
    "status": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from_tick": {"type": "integer", "minimum": 0},
    "valid_until_tick": {"type": ["integer", "null"], "minimum": 0},
    "source": {"type": "object"},
    "version": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
